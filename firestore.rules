rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null && request.auth.token.email is string; }
    function em() { return request.auth.token.email; }
    function isJefe() { return signed() && em() in ['j.gina@incentivos-tyt.app', 'j.cesar@incentivos-tyt.app']; }
    function marcas() { return ['honor','huawei','kalley','motorola','oppo','samsung','tcl','tecno','vivo','xiaomi','zte','tecnologia']; }
    function aliados() { return ['altycom-barranquilla','conexiones-digitales','conexiones-digitales-barranquilla','contactmaster-bpo-manizales','cos-barranquilla','gnp-cali','voicetech-medellin','bentoint','cos-bogota','one-contact-bogota','vector-bogota','asiste-ing','gnp','arcos-bogota','atento-bogota']; }
    function isEsp() { return signed() && em() in ['e.correa-ramirez-oscar-ivan@incentivos-tyt.app', 'e.vargas-martinez-jorge-andres@incentivos-tyt.app', 'e.velasquez-moreno-john-fernando@incentivos-tyt.app', 'e.martinez-poveda-carlos-andres@incentivos-tyt.app', 'e.zapata-gonzalez-vladimir@incentivos-tyt.app']; }
    function isMarca(ms) { return signed() && ms in marcas() && em() == 'm.' + ms + '@incentivos-tyt.app'; }
    function isAliado(as) { return signed() && as in aliados() && em() == 'a.' + as + '@incentivos-tyt.app'; }

    // Incentivos que suben las marcas (completos, con pagos de aliado, staff y asesor)
    match /items/{id} {
      allow read: if isJefe() || isEsp() || isMarca(resource.data.ms);
      allow create: if isMarca(request.resource.data.ms)
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.mes is string;
      // El jefe aprueba o rechaza; la marca solo puede corregir y reenviar lo rechazado
      allow update: if isJefe()
                    || (isMarca(resource.data.ms)
                        && resource.data.estado == 'rechazado'
                        && request.resource.data.estado == 'pendiente'
                        && request.resource.data.ms == resource.data.ms
                        && request.resource.data.marca == resource.data.marca
                        && request.resource.data.tipo == resource.data.tipo);
    }

    // Copia publicada para cada aliado (solo su meta)
    match /pub_ali/{id} {
      allow read: if isJefe() || isAliado(resource.data.as);
      allow write: if isJefe();
    }

    // Calendario de días de marca y logos
    match /cal/{fecha} {
      allow read: if signed();
      allow write: if isJefe();
    }
    match /logos/{ms} {
      allow read: if signed();
      allow write: if isMarca(ms) && request.resource.data.data is string
                   && request.resource.data.data.size() < 300000;
    }

    // Imágenes de las ofertas
    match /imgs/{id} {
      allow read: if signed();
      allow create: if isMarca(request.resource.data.ms) && request.resource.data.data is string
                    && request.resource.data.data.size() < 1000000;
      allow delete: if isJefe();
    }

    // Marca personal: si el usuario ya cambió su contraseña
    match /perfil/{uid} {
      allow read, write: if signed() && request.auth.uid == uid;
    }
  }
}
